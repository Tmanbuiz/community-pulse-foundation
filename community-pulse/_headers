/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# A week, and deliberately not `immutable`. A year with `immutable` is the
# right rule for content-hashed filenames (logo.a3f9c2.jpg), where a changed
# image is always a changed URL. These filenames are stable - logo-clean.jpg
# stays logo-clean.jpg when the picture behind it is replaced - so that rule
# would strand returning visitors on the old image for a year, with the
# browser refusing even to revalidate it.
/assets/images/*
  Cache-Control: public, max-age=604800, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# The CRM application assets, exempted from the hour-long cache above.
#
# Note on how this actually behaves: Pages MERGES every matching rule
# rather than letting the most specific or the last one win, so these
# files are served the union of both rules -
#   public, max-age=3600, must-revalidate, no-store, private
# - which is self-contradictory to read but correct in effect: no-store
# takes precedence per RFC 9111, and Cloudflare reports cf-cache-status
# BYPASS for them. Do not "tidy" this by deleting the rule below on the
# assumption that the generic one is being overridden; it is not, and
# removing it would leave the CRM cached for an hour again.
#
# The CRM is a single-page app talking to a versioned API, used by a
# handful of admins. Caching it saves nothing worth having and costs a
# great deal: after a deploy the browser keeps running the old app
# against the new API for up to an hour, without even revalidating, and
# the symptom is silently missing data rather than an error. That cost
# us most of an evening's debugging.
/assets/js/admin-crm.js
  Cache-Control: no-store, private

/assets/css/admin-crm.css
  Cache-Control: no-store, private

# The CRM renders volunteer personal data. Nothing here may sit in a
# shared cache, and it must never be framed or indexed.
/crm/*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow
  Referrer-Policy: no-referrer

/api/admin/*
  Cache-Control: no-store, private
  X-Robots-Tag: noindex, nofollow
